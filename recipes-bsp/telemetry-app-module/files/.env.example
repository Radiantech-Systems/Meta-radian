# URL of the backend running on the Ubuntu server (NOT on the Jetson)
SERVER_URL=http://192.168.1.100:8000

# Seconds between telemetry samples
COLLECTION_INTERVAL_SECONDS=1

# Stable identifier for this Jetson (defaults to hostname if unset)
DEVICE_ID=jetson-orin-01
DEVICE_NAME=Jetson AGX Orin #1

# Network interface used for upload/download speed + MAC lookup
NETWORK_INTERFACE=eth0

# Must match the backend's API_KEY exactly once auth is enabled.
API_KEY=
